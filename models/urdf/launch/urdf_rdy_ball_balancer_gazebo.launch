<launch>
  <param name="robot_description" textfile="$(find fusion2urdf)/urdf_rdy_ball_balancer/urdf_rdy_ball_balancer.urdf"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-param robot_description -urdf -model urdf_rdy_ball_balancer"/>
</launch>
